class RevealScreen(BaseScreen):

    def prepare(self, name):

        self.final_name = name

    def on_enter(self):

        self.clear_widgets()
        self.draw_background()

        layout = BoxLayout(
            orientation="vertical",
            padding=dp(20),
            spacing=dp(12)
        )

        layout.add_widget(
            label(
                "CODE ACCEPTED",
                18,
                GREEN,
                True
            )
        )

        layout.add_widget(
            label(
                "THE MOMENT OF TRUTH",
                24,
                GOLD,
                True
            )
        )

        self.countdown = label(
            "3",
            60,
            CYAN,
            True
        )

        self.countdown.size_hint_y = None
        self.countdown.height = dp(110)

        layout.add_widget(
            self.countdown
        )

        self.result = label(
            "",
            28,
            PINK,
            True
        )

        self.result.size_hint_y = None
        self.result.height = dp(140)

        layout.add_widget(
            self.result
        )

        self.play = button(
            "PLAY AGAIN",
            PURPLE
        )

        self.play.disabled = True

        self.play.bind(
            on_release=lambda x:
            self.play_again()
        )

        layout.add_widget(
            self.play
        )

        home = button(
            "HOME",
            CARD2
        )

        home.bind(
            on_release=lambda x:
            setattr(
                self.manager,
                "current",
                "home"
            )
        )

        layout.add_widget(home)

        self.add_widget(layout)

        self.number = 3

        Clock.schedule_interval(
            self.tick,
            0.9
        )

    def tick(self, dt):

        if self.number > 0:

            self.countdown.text = str(
                self.number
            )

            Animation(
                font_size=sp(75),
                duration=0.25
            ).start(
                self.countdown
            )

            self.number -= 1

            return True

        self.countdown.text = "REVEALED"

        self.result.text = self.final_name

        Animation(
            font_size=sp(38),
            duration=0.5
        ).start(
            self.result
        )

        self.play.disabled = False

        return False

    def play_again(self):

        self.manager.get_screen(
            "code"
        ).reset_game()

        self.manager.current = "code"


