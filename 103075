def background(widget, colour=CARD, radius=18):

    with widget.canvas.before:
        Color(*colour)

        widget.bg_rect = RoundedRectangle(
            pos=widget.pos,
            size=widget.size,
            radius=[dp(radius)]
        )

    def update(*args):
        widget.bg_rect.pos = widget.pos
        widget.bg_rect.size = widget.size

    widget.bind(
        pos=update,
        size=update
    )


def label(
    text="",
    font=16,
    colour=WHITE,
    bold=False
):

    lbl = Label(
        text=text,
        font_size=sp(font),
        color=colour,
        bold=bold,
        halign="center",
        valign="middle",
        shorten=False
    )

    # This prevents long text from running outside
    # the available width.
    lbl.bind(
        width=lambda obj, value:
        setattr(
            obj,
            "text_size",
            (value - dp(8), None)
        )
    )

    return lbl


def button(
    text,
    colour=PURPLE,
    height=52,
    text_colour=WHITE
):

    btn = Button(
        text=text,
        font_size=sp(15),
        bold=True,
        color=text_colour,
        background_normal="",
        background_color=(0, 0, 0, 0),
        size_hint_y=None,
        height=dp(height)
    )

    with btn.canvas.before:
        Color(*colour)

        btn.button_rect = RoundedRectangle(
            pos=btn.pos,
            size=btn.size,
            radius=[dp(15)]
        )

    def update(*args):
        btn.button_rect.pos = btn.pos
        btn.button_rect.size = btn.size

    btn.bind(
        pos=update,
        size=update
    )

    # Small press animation
    def pressed(instance):

        Animation(
            opacity=0.65,
            duration=0.06
        ).start(instance)

        Clock.schedule_once(
            lambda dt:
            Animation(
                opacity=1,
                duration=0.10
            ).start(instance),
            0.08
        )

    btn.bind(on_press=pressed)

    return btn


class BaseScreen(Screen):

    def draw_background(self):

        with self.canvas.before:
            Color(*BG)

            self.background_rect = RoundedRectangle(
                pos=self.pos,
                size=self.size,
                radius=[0]
            )

        self.bind(
            pos=lambda obj, value:
            setattr(
                self.background_rect,
                "pos",
                value
            ),

            size=lambda obj, value:
            setattr(
                self.background_rect,
                "size",
                value
            )
        )


