        note.size_hint_y = None
        note.height = dp(38)

        content.add_widget(note)

        scroll.add_widget(content)

        self.add_widget(scroll)

    def add_coordinate(self):

        try:

            row = int(
                self.row_input.text
            )

            column = int(
                self.column_input.text
            )

        except:

            self.status.text = (
                "PLEASE ENTER NUMBERS ONLY"
            )

            self.status.color = RED

            return

        if row < 1 or row > 5:

            self.status.text = (
                "ROW MUST BE 1 TO 5"
            )

            self.status.color = RED

            return

        if column < 1 or column > 6:

            self.status.text = (
                "COLUMN MUST BE 1 TO 6"
            )

            self.status.color = RED

            return

        letter_value = ALPHABET[
            row - 1
        ][
            column - 1
        ]

        if not letter_value:

            self.status.text = (
                "THAT POSITION HAS NO LETTER"
            )

            self.status.color = RED

            return

        # The decoded letter is NOT shown.
        self.current_letters.append(
            letter_value
        )

        self.row_input.text = ""
        self.column_input.text = ""

        self.status.text = (
            "SECRET LETTERS LOCKED: "
            + str(len(self.current_letters))
        )

        self.status.color = GREEN

    def undo(self):

        if self.current_letters:

            self.current_letters.pop()

        self.status.text = (
            "SECRET LETTERS LOCKED: "
            + str(len(self.current_letters))
        )

        self.status.color = GREEN

    def finish_part(self):

        if not self.current_letters:

            self.status.text = (
                "ADD AT LEAST ONE LETTER FIRST"
            )

            self.status.color = RED

            return

        self.parts.append(
            "".join(
                self.current_letters
            )
        )

        self.current_letters = []

        self.part_number += 1

        self.part_label.text = (
            "NAME PART "
            + str(self.part_number)
        )

        self.status.text = (
            "NAME PART LOCKED"
        )

        self.status.color = GOLD

    def reveal(self):

        if self.current_letters:

            self.parts.append(
                "".join(
                    self.current_letters
                )
            )

            self.current_letters = []

        if not self.parts:

            self.status.text = (
                "ENTER A NAME FIRST"
            )

            self.status.color = RED

            return

        final_name = " ".join(
            self.parts
        )

        reveal_screen = self.manager.get_screen(
            "reveal"
        )

        reveal_screen.prepare(
            final_name
        )

        self.manager.current = "reveal"


